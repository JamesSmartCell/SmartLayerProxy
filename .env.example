# Cloudflare R2 (for Remote Camera uploads)
# See REMOTE_CAMERA_SETUP.md for step-by-step instructions

# 1. Account ID: Dashboard → R2 Overview (right sidebar) or Account Home → Copy account ID
R2_ACCOUNT_ID=

# 2. API Token: R2 → Manage R2 API tokens → Create token → Object Read & Write on garage-camera
#    Copy Access Key ID and Secret Access Key (secret is shown ONCE only)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 3. Bucket name (you created this)
R2_BUCKET_NAME=garage-camera

# 4. Public URL: garage-camera bucket → Settings → Public Development URL → Enable
#    Copy the URL shown (e.g. https://pub-xxxxxxxx.r2.dev)
R2_PUBLIC_URL=

# Optional: if proxy is behind reverse proxy
# PROXY_PUBLIC_URL=https://proxy.percolate.one
