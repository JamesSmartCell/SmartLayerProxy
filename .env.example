# Server Configuration
# SERVER_PORT=8081

# Device Listener Ports
# UDP_PORT=8083
# TCP_PORT=8082

# Telemetry Configuration
# Path to SQLite database for telemetry storage
TELEMETRY_DB_PATH=./data/telemetry.db

# Number of days to retain telemetry events (default: 30)
TELEMETRY_RETENTION_DAYS=30

# API key for accessing telemetry endpoints (REQUIRED for telemetry)
# Generate a secure random key: openssl rand -base64 32
TELEMETRY_API_KEY=your-secret-api-key-here

# Admin addresses (comma-separated Ethereum addresses for admin operations)
# Used for firmware upload/rollback and telemetry ack
# Example: ADMIN_ADDRESSES=0x1234...,0x5678...
ADMIN_ADDRESSES=
TELEMETRY_ADMIN_ADDRESSES=

# Telemetry feed configuration
TELEMETRY_FEED_MAX_LIMIT=5000
# Force dry-run mode for telemetry ack (default: false)
# When true, ack endpoint always returns wouldDelete instead of deleting
TELEMETRY_ACK_ENABLED=false

# Zigbee gateway diagnostics (POST /api/diag/zbgw, header X-ZBGW-Diag)
# Comma-separated product tokens — never commit real tokens
# Generate: openssl rand -base64 32
ZBGW_DIAG_TOKENS=
# Optional separate SQLite path (default: sibling of TELEMETRY_DB_PATH → zigbee.db)
# ZIGBEE_DB_PATH=./data/zigbee.db

# Cloudflare R2 Configuration (for camera uploads and firmware storage)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=garage-camera
# R2_PUBLIC_URL=
# Global firmware defaults (do NOT repurpose these for a single project):
# R2_FIRMWARE_BUCKET_NAME=  # Optional: separate bucket for firmware (defaults to R2_BUCKET_NAME)
# R2_FIRMWARE_PUBLIC_URL=   # Optional: public URL for firmware bucket (e.g., https://pub-xxxx.r2.dev)
#
# Per-project firmware overrides (project "zigbee-gateway" → suffix ZIGBEE_GATEWAY):
# R2_FIRMWARE_BUCKET_NAME__ZIGBEE_GATEWAY=esp-firmware
# R2_FIRMWARE_PUBLIC_URL__ZIGBEE_GATEWAY=https://pub-862b54f8a0134f8d8276f74732be8015.r2.dev
# Optional bucket-scoped credentials (fall back to global R2_* if unset):
# R2_ACCESS_KEY_ID__ZIGBEE_GATEWAY=
# R2_SECRET_ACCESS_KEY__ZIGBEE_GATEWAY=
# R2_ACCOUNT_ID__ZIGBEE_GATEWAY=

# Firmware upload configuration
FIRMWARE_UPLOAD_MAX_SIZE_MB=10

# Passkey/WebAuthn Configuration
PASSKEY_RP_ID=percolate.one
PASSKEY_RP_NAME=GarageDoorKey
PASSKEY_ORIGIN=https://wallet.percolate.one

# Proxy Public URL (for camera upload callbacks)
# PROXY_PUBLIC_URL=https://proxy.percolate.one

# Client IP / PROXY protocol (Caddy → SSH tunnel → SLP)
# Peers allowed to send PROXY headers and whose X-Forwarded-For we trust.
# Default: 127.0.0.1,::1 (loopback — correct for reverse tunnels)
# PROXY_PROTOCOL_TRUSTED=127.0.0.1,::1
# TRUSTED_PROXIES=127.0.0.1,::1
# When an untrusted peer sends PROXY: ignore (default) | reject
# PROXY_PROTOCOL_UNTRUSTED=ignore
# Legacy: trust XFF from any peer (Cloudflare etc.)
# TRUST_PROXY=false

# Session IP pinning (after ESP signed login)
# off | log (default) | enforce
# log: emit ip_pin_violation telemetry + journal, allow traffic (safe first deploy)
# enforce: reject mismatched commands/re-auth and terminate the TCP session
# Loopback/unknown IPs (legacy tunnel without PROXY) are never pinned/enforced
# IP_PIN_MODE=log

# Signed RPC proxy (device chain reads via waterfall-rpc)
# Dedicated signer key — NEVER commit the real value; load from gitignored .env only.
# Generate: openssl rand -hex 32   → use as 0x<64 hex> private key
# Firmware compiles the corresponding address from GET /api/rpc/signer
# RPC_SIGNER_PRIVATE_KEY=0x...
# Per-device / per-IP rate limits (requests per rolling 60s)
# RPC_RATE_LIMIT_DEVICE_PER_MIN=30
# RPC_RATE_LIMIT_IP_PER_MIN=60
# Force waterfall Chainlist/rankings refresh interval (default 24h).
# Library also auto-refreshes weekly; this timer forces a fresher cadence.
# RPC_CATALOG_REFRESH_MS=86400000
