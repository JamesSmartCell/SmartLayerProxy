# Server Configuration
# SERVER_PORT=8081

# Device Listener Ports
# UDP_PORT=8083
# TCP_PORT=8082

# Telemetry Configuration
# Path to SQLite database for telemetry storage
TELEMETRY_DB_PATH=./data/telemetry.db

# Number of days to retain telemetry events (default: 30)
TELEMETRY_RETENTION_DAYS=30

# API key for accessing telemetry endpoints (REQUIRED)
# Generate a secure random key: openssl rand -base64 32
TELEMETRY_API_KEY=your-secret-api-key-here

# Cloudflare R2 Configuration (optional, for camera uploads)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# Passkey/WebAuthn Configuration
PASSKEY_RP_ID=percolate.one
PASSKEY_RP_NAME=GarageDoorKey
PASSKEY_ORIGIN=https://wallet.percolate.one

# Proxy Public URL (for camera upload callbacks)
# PROXY_PUBLIC_URL=https://proxy.percolate.one
