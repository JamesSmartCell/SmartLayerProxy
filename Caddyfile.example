# Caddy reverse proxy for SmartLayerProxy
# Only forwards /api to the backend; all other paths return 403 and close.
#
# ECONNREFUSED is not possible here - the connection is already established
# before the path is known. Caddy can only refuse by returning HTTP (e.g. 403)
# or by not proxying. This config blocks non-API at the Caddy layer.

:8080 {
    # Only /api* goes to the backend (full path preserved)
    handle /api* {
        reverse_proxy localhost:8081
    }

    # Everything else: 403 Forbidden
    handle {
        respond 403
    }
}

# Zigbee gateway diagnostics hostname
# Devices POST to https://zigbeediagnostics.percolate.one/api/diag/zbgw
# Routes are Host-independent; reverse_proxy the same upstream as scriptproxy.
#
# zigbeediagnostics.percolate.one {
#     handle /api* {
#         reverse_proxy localhost:8081
#     }
#     handle {
#         respond 403
#     }
# }
#
# Or, if scriptproxy already uses a named upstream / site block, point both
# hostnames at that same reverse_proxy target.
