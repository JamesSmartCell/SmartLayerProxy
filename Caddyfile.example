# Caddy reverse proxy for SmartLayerProxy
# Only forwards /api to the backend; all other paths return 403 and close.
#
# ECONNREFUSED is not possible here - the connection is already established
# before the path is known. Caddy can only refuse by returning HTTP (e.g. 403)
# or by not proxying. This config blocks non-API at the Caddy layer.

:8080 {
    # Only /api* goes to the backend (full path preserved)
    handle /api* {
        reverse_proxy localhost:8081
    }

    # Everything else: 403 Forbidden
    handle {
        respond 403
    }
}
