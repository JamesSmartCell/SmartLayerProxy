{
  "name": "smartlayer-proxy",
  "version": "0.1.0",
  "description": "Lightweight TypeScript proxy for SmartLayer IoT devices - UDP/TCP bridge with Ethereum auth",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:tools": "tsc --project tsconfig.tools.json --noEmit",
    "telemetry:pull": "ts-node tools/telemetry/pull.ts",
    "telemetry:analyse": "ts-node tools/telemetry/analyse.ts",
    "telemetry:zigbee:pull": "ts-node tools/telemetry/pull-zigbee.ts",
    "telemetry:zigbee:analyse": "ts-node tools/telemetry/analyse-zigbee.ts",
    "telemetry:all": "ts-node tools/telemetry/all.ts",
    "firmware:upload": "ts-node tools/firmware/upload.ts",
    "firmware:upload-setup": "ts-node tools/firmware/upload-setup.ts",
    "firmware:revoke": "ts-node tools/firmware/revoke.ts",
    "firmware:revoke:cancel": "ts-node tools/firmware/revoke.ts --cancel"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@simplewebauthn/server": "^13.2.3",
    "@smarttokenlabs/waterfall-rpc": "^0.9.10",
    "better-sqlite3": "^11.6.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.1",
    "rimraf": "^5.0.5",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^2.1.5"
  }
}
